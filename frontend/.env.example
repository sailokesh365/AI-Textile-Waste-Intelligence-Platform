# ==========================================
# AI Textile Waste Intelligence Platform - Frontend Environment Variables
# ==========================================

# Backend REST API Base URL
# Local Dev: http://localhost:5000/api
# Local Docker (Nginx Reverse Proxy): /api
# Production (Firebase Hosting / Cloud Run): https://<your-backend-service-url>/api
VITE_API_BASE_URL=http://localhost:5000/api

# Backend Server Root URL (for image asset resolution)
# Local Dev: http://localhost:5000
# Local Docker (Nginx Reverse Proxy): "" (empty string for same-origin proxying)
# Production (Firebase Hosting / Cloud Run): https://<your-backend-service-url>
VITE_SERVER_BASE_URL=http://localhost:5000
