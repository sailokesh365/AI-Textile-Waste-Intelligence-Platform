# ==========================================
# AI Textile Waste Intelligence Platform - Backend Environment Variables
# ==========================================

# Server Listening Port (Render assigns PORT automatically)
PORT=5000

# MongoDB Database Connection URI
# Local Dev: mongodb://127.0.0.1:27017/textile_waste_db
# Local Docker: mongodb://mongodb:27017/textile_waste_db
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/textile_waste_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/textile_waste_db

# JSON Web Token Secret Key for Session Authentication
# Use a strong, random 64-character string in production
JWT_SECRET=your_super_secret_jwt_key_here

# Python FastAPI AI Microservice URL
# Local Dev: http://127.0.0.1:8000
# Local Docker: http://ai-service:8000
# Production (Render): https://ai-textile-ai-service.onrender.com (or internal private service address)
AI_SERVER_URL=http://127.0.0.1:8000

# CORS Allowed Origin
# Local Dev/Docker: *
# Production (Render): https://ai-textile-frontend.onrender.com (or your custom domain)
CORS_ORIGIN=*
